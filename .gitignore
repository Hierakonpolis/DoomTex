# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz

# Rendered output is a build product, not source
*.pdf
*.png
*.ppm

# ...except the documentation images, which are committed on purpose.
# Regenerate with:  pdflatex doom.tex && pdftoppm -png -r 200 doom.pdf
#                   pdflatex tools/texsheet.tex
!docs/*.png

# Runtime state. Both are regenerated automatically: a missing state.tex
# starts a new game, a missing input.txt reads as "stand still".
state.tex
input.txt

# Generated by TeX on first run; delete to force regeneration.
# The directory itself must stay, TeX cannot create it.
cache/*.tex
