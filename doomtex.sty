%% DoomTex -- Doom rendered by TeX macro expansion.
%% One pdflatex run = one frame.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{doomtex}[2026/08/28 DoomTex engine]
\RequirePackage{expl3}
\RequirePackage{xcolor}
\ExplSyntaxOn
%% Screen geometry, in DoomTex pixels.
\int_const:Nn \c_dtex_screen_w_int  {320}
\int_const:Nn \c_dtex_screen_h_int  {200}
\int_const:Nn \c_dtex_horizon_int   {100}
%% Physical size of one DoomTex pixel.
\dim_const:Nn \c_dtex_px_dim {1bp}
%% Seam overlap.  Poppler's Cairo backend (evince, xreader) antialiases
%% every rectangle independently, so two exactly abutting fills each cover
%% about half of the boundary device pixel and source-over compositing
%% leaves the page showing through as a hairline grid.  Each band is
%% therefore drawn slightly wider and deeper than its slot and the extra is
%% taken back with a negative kern, so neighbours overlap by this much
%% while the layout stays pixel-exact.
\dim_const:Nn \c_dtex_overlap_dim {0.75bp}
\ExplSyntaxOff
\input{engine/fixed.tex}
\input{engine/map.tex}
\input{engine/stateio.tex}
\input{engine/palette.tex}
\input{engine/textures.tex}
\input{engine/raycast.tex}
